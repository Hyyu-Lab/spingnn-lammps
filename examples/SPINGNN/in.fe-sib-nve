# Self-contained analytic bcc Fe demonstration; not a production model.
units metal
atom_style spin
boundary p p p
atom_modify map array sort 0 0.0
lattice bcc 2.8665
region box block 0 4 0 4 0 4
create_box 1 box
create_atoms 1 box
mass 1 55.845
set group all spin/random 31 2.2
velocity all create 50 4928459 rot yes dist gaussian
pair_style hybrid/overlay lj/cut 3.5 spin/exchange 3.5
pair_coeff * * lj/cut 0.5 2.2
pair_coeff * * spin/exchange exchange 3.4 0.02726 0.2171 1.841 offset yes
neighbor 0.1 bin
neigh_modify every 1 delay 0 check yes
timestep 0.001
fix integrate all spin/sib 0 0 531791 lattice moving
compute spin_direction all property/atom spx spy spz
dump frame all custom 100 trajectory.dump id x y z vx vy vz c_spin_direction[1] c_spin_direction[2] c_spin_direction[3]
dump_modify frame sort id format float %.17g
thermo 10
thermo_style custom step time temp pe ke etotal press vol
thermo_modify norm no format float %.17g
run 1000
print SPINGNN_EXAMPLE_COMPLETE
