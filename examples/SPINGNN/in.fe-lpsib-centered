# Analytic demonstration; not a production model or certified timestep.
units metal
atom_style spin
boundary p p p
atom_modify map array sort 0 0.0
lattice bcc 2.8665
region box block 0 4 0 4 0 4
create_box 1 box
create_atoms 1 box
mass 1 55.845
set group all spin/random 31 2.2
pair_style hybrid/overlay lj/cut 3.5 spin/exchange 3.951153269653658
pair_coeff * * lj/cut .5 2.2 3.5
pair_modify pair lj/cut shift yes
pair_coeff * * spin/exchange exchange 3.951153269653658 .02726 .2171 1.841 offset yes
neighbor .3 bin
neigh_modify every 1 delay 0 check yes
timestep .00005
fix integrate all spin/lpsib 300 1 531791 lattice moving accept 10 predictor fresh ou 300 .1 531792
compute gp all property/atom spx spy spz sp fmx fmy fmz
dump frame all custom 10 trajectory.dump id x y z c_gp[1] c_gp[2] c_gp[3] c_gp[4] c_gp[5] c_gp[6] c_gp[7]
dump_modify frame sort id format float %.17g
thermo 10
thermo_style custom step pe ke etotal press vol
thermo_modify norm no format float %.17g
run 100
print SPINGNN_EXAMPLE_COMPLETE
